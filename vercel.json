{
  "version": 2,
  "builds": [
    {
      "src": "x-content-agent/api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "x-content-agent/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "x-content-agent/api/$1" },
    { "src": "/(.*\\..+)$", "dest": "x-content-agent/public/$1" },
    { "src": "/(.*)", "dest": "x-content-agent/public/index.html" }
  ]
}
